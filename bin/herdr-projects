#!/bin/sh
# Runs lib/herdr_projects with Python 3.11 or newer. macOS's own
# /usr/bin/python3 is older, so a bare python3 isn't enough.
#
# Finding one means starting each candidate, and a version manager's shim
# (pyenv, asdf) can take a few hundred milliseconds per start. So the real
# interpreter's path is cached in the plugin's state directory and later
# runs exec it directly.

root=${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
script=$root/lib/herdr_projects/__main__.py
cache=${HERDR_PLUGIN_STATE_DIR:+$HERDR_PLUGIN_STATE_DIR/python}

if [ -n "$cache" ] && [ -r "$cache" ]; then
  IFS= read -r py <"$cache"
  if [ -n "$py" ] && [ -x "$py" ]; then
    exec "$py" -I -S "$script" "$@"
  fi
fi

for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  py=$("$candidate" -I -S -c \
    'import sys; print(sys.executable if sys.version_info >= (3, 11) else "")' 2>/dev/null)
  if [ -n "$py" ] && [ -x "$py" ]; then
    if [ -n "$cache" ]; then
      printf '%s\n' "$py" >"$cache.$$" 2>/dev/null && mv -f "$cache.$$" "$cache" 2>/dev/null
    fi
    exec "$py" -I -S "$script" "$@"
  fi
done

echo "herdr-projects: needs Python 3.11 or newer on PATH" >&2
if [ -t 0 ]; then
  printf '\npress enter to close'
  read -r _
fi
exit 1
